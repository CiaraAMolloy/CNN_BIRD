    "class Sigmoid:\n",
    "\n",
    "    def forward(self, x):\n",
    "\n",
    "        self.output = 1/(1+np.exp(-x))\n",
    "\n",
    "        return self.output\n",
    "\n",
    "    def backward(self, grad):\n",
    "\n",
    "        return (\n",
    "            grad *\n",
    "            self.output *\n",
    "            (1-self.output)\n",
    "        )"
   ]
