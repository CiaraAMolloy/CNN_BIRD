    "def loss(y_true, y_pred):\n",
    "\n",
    "    eps = 1e-7\n",
    "\n",
    "    return -(\n",
    "        y_true*np.log(y_pred+eps)\n",
    "        +\n",
    "        (1-y_true)*np.log(\n",
    "            1-y_pred+eps\n",
    "        )\n",
    "    )"
