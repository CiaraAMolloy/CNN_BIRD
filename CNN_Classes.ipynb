    "class ReLU:\n",
    "\n",
    "    def forward(self, x):\n",
    "\n",
    "        self.input = x\n",
    "\n",
    "        return np.maximum(0, x)\n",
    "\n",
    "    def backward(self, grad):\n",
    "\n",
    "        return grad * (self.input > 0)\n"
