    "class ConvLayer:\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        in_channels,\n",
    "        out_channels,\n",
    "        filter_size=3\n",
    "    ):\n",
    "\n",
    "        self.in_channels = in_channels\n",
    "        self.out_channels = out_channels\n",
    "        self.filter_size = filter_size\n",
    "\n",
    "        self.filters = (\n",
    "            np.random.randn(\n",
    "                out_channels,\n",
    "                in_channels,\n",
    "                filter_size,\n",
    "                filter_size\n",
    "            ) * 0.1\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "\n",
    "        self.input = x\n",
    "\n",
    "        channels, h, w = x.shape\n",
    "        fs = self.filter_size\n",
    "\n",
    "        output = np.zeros(\n",
    "            (\n",
    "                self.out_channels,\n",
    "                h - fs + 1,\n",
    "                w - fs + 1\n",
    "            )\n",
    "        )\n",
    "\n",
    "        for f in range(self.out_channels):\n",
    "\n",
    "            for i in range(h - fs + 1):\n",
    "\n",
    "                for j in range(w - fs + 1):\n",
    "\n",
    "                    region = x[\n",
    "                        :,\n",
    "                        i:i+fs,\n",
    "                        j:j+fs\n",
    "                    ]\n",
    "\n",
    "                    output[f, i, j] = np.sum(\n",
    "                        region * self.filters[f]\n",
    "                    )\n",
    "\n",
    "        return output"
   ]
